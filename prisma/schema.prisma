datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ATTENDANCE_OFFICER
  TREASURER
  FINANCE_OFFICER
  AUDITOR
}

enum AccountStatus {
  PENDING   // Newly signed up, waiting for admin approval
  ACTIVE    // Approved — full access
  REJECTED  // Rejected by admin
}

enum PaymentStatus {
  UNPAID
  PENDING
  APPROVED
  REJECTED
}

enum ScanMode {
  TIME_IN
  TIME_OUT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

// Alpha List Student Model
model Student {
  id           String   @id // Student ID (e.g., "07305868")
  fullName     String   // e.g., "MARBELLA, Grace Santonia"
  course       String   // e.g., "BSIT"
  yearLevel    String   // e.g., "4"
  section      String   // e.g., "BSIT 4"
  academicYear String   @default("2025-2026")
  semester     String   @default("1st Sem")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Officer Accounts for Role-Based Access Control
model Officer {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  roles         Role[]
  status        AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  approvedClaims     PaymentClaim[]      @relation("ApprovedByTreasurer")
  eReceipts          EReceipt[]
  auditLogs          AuditLog[]
  cashAdvances       CashAdvance[]
  liquidationRecords LiquidationRecord[]
}

// Canonical Student Profile
model StudentProfile {
  id                 String              @id @default(cuid())
  studentNumber      String              @unique
  fullName           String
  program            String              // e.g., BSCE, BSCS, BSIT
  yearLevel          Int                 // 1 to 4
  dwclEmail          String              @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  identifierMappings IdentifierMapping[]
  paymentClaims      PaymentClaim[]
  attendanceRecords  AttendanceRecord[]
}

// Barcode & Student ID Association
model IdentifierMapping {
  id           String         @id @default(cuid())
  barcodeValue String         @unique
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
}

// Collection Periods & Fee Items
model CollectionPeriod {
  id            String         @id @default(cuid())
  name          String         // e.g. "A.Y. 2026-2027 1st Sem"
  isActive      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  
  feeItems      FeeItem[]
  paymentClaims PaymentClaim[]
}

model FeeItem {
  id                 String           @id @default(cuid())
  collectionPeriodId String
  collectionPeriod   CollectionPeriod @relation(fields: [collectionPeriodId], references: [id])
  name               String           // e.g., "Membership Fee"
  amount             Decimal          @db.Decimal(10, 2)
  requiresShirtSize  Boolean          @default(false)
  isRequired         Boolean          @default(true)
  createdAt          DateTime         @default(now())
  
  claimItems         ClaimItem[]
}

// Payment Claims Submitted by Students
model PaymentClaim {
  id                   String           @id @default(cuid())
  collectionPeriodId   String
  collectionPeriod     CollectionPeriod @relation(fields: [collectionPeriodId], references: [id])
  studentId            String?
  student              StudentProfile?  @relation(fields: [studentId], references: [id])
  
  submittedStudentNo   String
  submittedFullName    String
  dwclEmail            String
  program              String
  yearLevel            Int
  shirtSize            String?
  
  paymentMethod        String           // Cash, GCash, Bank Transfer
  paymentReference     String           // Reference / OR Number
  normalizedReference  String           // Normalized for duplicate checks
  paymentDate          DateTime
  proofOfPaymentUrl    String           // Storage URL for proof image
  privacyConsent       Boolean          @default(true)
  consentTimestamp     DateTime         @default(now())
  
  status               PaymentStatus    @default(PENDING)
  
  // Treasurer Approval Fields
  verifiedByOfficerId  String?
  verifiedByOfficer    Officer?         @relation("ApprovedByTreasurer", fields: [verifiedByOfficerId], references: [id])
  verificationSource   String?          // GCash, Bank Statement, Cash Logbook
  verificationNote     String?
  rejectionReason      String?
  verifiedAt           DateTime?
  
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  
  claimItems           ClaimItem[]
  eReceipt             EReceipt?
}

model ClaimItem {
  id             String       @id @default(cuid())
  paymentClaimId String
  paymentClaim   PaymentClaim @relation(fields: [paymentClaimId], references: [id], onDelete: Cascade)
  feeItemId      String
  feeItem        FeeItem      @relation(fields: [feeItemId], references: [id])
  amount         Decimal      @db.Decimal(10, 2)
}

// Electronic Receipts Generated on Approval
model EReceipt {
  id             String         @id @default(cuid())
  receiptNumber  String         @unique // Sequential e.g., LICOES-2026-0001
  paymentClaimId String         @unique
  paymentClaim   PaymentClaim   @relation(fields: [paymentClaimId], references: [id])
  issuedById     String
  issuedBy       Officer        @relation(fields: [issuedById], references: [id])
  pdfUrl         String?
  deliveryStatus DeliveryStatus @default(QUEUED)
  deliveryReason String?
  issuedAt       DateTime       @default(now())
}

// Events & Attendance
model Event {
  id              String             @id @default(cuid())
  name            String
  location        String
  // Time-In window
  timeInStart     DateTime?
  timeInEnd       DateTime?
  // Time-Out window
  timeOutStart    DateTime?
  timeOutEnd      DateTime?
  isClosed        Boolean            @default(false)
  closedAt        DateTime?
  createdAt       DateTime           @default(now())

  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id])
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())
  
  sessions  AttendanceSession[]

  @@unique([eventId, studentId])
}

model AttendanceSession {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  timeIn             DateTime
  timeOut            DateTime?
  isLateTimeIn       Boolean          @default(false)
  isLateTimeOut      Boolean          @default(false)
  scannedBarcode     String
  operationId        String           @unique
  createdAt          DateTime         @default(now())
}

// Audit Logging
model AuditLog {
  id           String   @id @default(cuid())
  officerId    String?
  officer      Officer? @relation(fields: [officerId], references: [id])
  action       String   // e.g., "PAYMENT_APPROVED", "ATTENDANCE_TIME_IN"
  targetRecord String   // e.g., "PaymentClaim", "AttendanceSession"
  recordId     String
  previousVal  String?  @db.Text
  newVal       String?  @db.Text
  reason       String?
  timestamp    DateTime @default(now())
}

// ─── New enums for remaining modules ───────────────────────────────────────

enum ConfigItemType {
  PROGRAM
  YEAR_LEVEL
  SHIRT_SIZE
  PAYMENT_METHOD
}

enum CashAdvanceStatus {
  OPEN
  LIQUIDATED
}

// ─── Admin Configuration Panel ─────────────────────────────────────────────

model SystemConfig {
  id        String         @id @default(cuid())
  type      ConfigItemType
  value     String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@unique([type, value])
}

// ─── Finance Expense Recorder ──────────────────────────────────────────────

model CashAdvance {
  id                 String            @id @default(cuid())
  recipientName      String            @db.VarChar(100)
  purpose            String            @db.VarChar(255)
  amount             Decimal           @db.Decimal(15, 2)
  dateIssued         DateTime
  status             CashAdvanceStatus @default(OPEN)
  createdByOfficerId String
  createdBy          Officer           @relation(fields: [createdByOfficerId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  expenses          Expense[]
  liquidationRecord LiquidationRecord?
}

model Expense {
  id                          String      @id @default(cuid())
  cashAdvanceId               String
  cashAdvance                 CashAdvance @relation(fields: [cashAdvanceId], references: [id])
  description                 String      @db.VarChar(255)
  vendorName                  String      @db.VarChar(100)
  amount                      Decimal     @db.Decimal(15, 2)
  datePurchased               DateTime
  acknowledgmentReceiptNumber String?     @unique
  // Snapshot fields — populated when AR is first generated
  arVendorName                String?
  arDescription               String?
  arAmount                    Decimal?    @db.Decimal(15, 2)
  arIssuedAt                  DateTime?
  createdAt                   DateTime    @default(now())

  evidence            ExpenseEvidence[]
  liquidationExpenses LiquidationExpense[]
}

model ExpenseEvidence {
  id         String   @id @default(cuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())
}

// ─── Liquidation Records ───────────────────────────────────────────────────

model LiquidationRecord {
  id                   String      @id @default(cuid())
  cashAdvanceId        String      @unique
  cashAdvance          CashAdvance @relation(fields: [cashAdvanceId], references: [id])
  totalLiquidated      Decimal     @db.Decimal(15, 2)
  unliquidatedBalance  Decimal     @db.Decimal(15, 2)
  submittedByOfficerId String
  submittedBy          Officer     @relation(fields: [submittedByOfficerId], references: [id])
  submittedAt          DateTime    @default(now())

  liquidationExpenses LiquidationExpense[]
}

model LiquidationExpense {
  id                  String            @id @default(cuid())
  liquidationRecordId String
  liquidationRecord   LiquidationRecord @relation(fields: [liquidationRecordId], references: [id])
  expenseId           String            @unique
  expense             Expense           @relation(fields: [expenseId], references: [id])
}
